# Copy this file to .env when local configuration is needed.
# Do not commit .env.

# Example TP-Link Deco gateway IP.
# This matches the currently detected local Deco gateway, but keep it as a configurable value.
ROUTER_IP=192.168.68.1

# Example local subnet observed on the home Wi-Fi.
LOCAL_SUBNET=192.168.68.0/24

# Cloudflare Security DNS targets observed on the current Wi-Fi adapter.
PRIMARY_DNS=1.1.1.2
SECONDARY_DNS=1.0.0.2

# DNS over HTTPS endpoint observed for Cloudflare Security DNS.
DNS_OVER_HTTPS_URL=https://security.cloudflare-dns.com/dns-query

# Optional future local alert settings.
ENABLE_BUZZER=false
ENABLE_LED=false
ENABLE_GOOGLE_HOME_ANNOUNCEMENT=false

# Optional future cloud alerting.
# Cloud alerts will not work during a full ACT internet outage unless backup internet is available.
ENABLE_CLOUD_ALERTS=false
